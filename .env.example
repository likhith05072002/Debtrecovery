# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=development                    # development | staging | production
APP_SECRET_KEY=change-me-32-chars-min
AGENCY_NAME="Apex Recovery Services"
AGENT_NAME="Alex"

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/debtcollector
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── Twilio ───────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+12138387179
TWILIO_WEBHOOK_BASE_URL=https://your-domain.com   # Must be public HTTPS

# ─── Deepgram (STT) ───────────────────────────────────────────────────────────
DEEPGRAM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPGRAM_MODEL=nova-2
DEEPGRAM_ENDPOINTING_MS=300

# ─── OpenAI (LLM + Whisper fallback) ─────────────────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_LLM_MODEL=gpt-4o
OPENAI_LLM_MAX_TOKENS=150
OPENAI_LLM_TEMPERATURE=0.4

# ─── ElevenLabs (TTS) ────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM       # "Rachel" — natural female voice
ELEVENLABS_MODEL_ID=eleven_turbo_v2
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY_BOOST=0.75

# ─── Rumik Silk (TTS — preferred for Indic languages) ────────────────────────
SILK_API_KEY=
SILK_MODEL_ID=silk-v1
SILK_SAMPLE_RATE=24000
SILK_DEFAULT_VOICE=silk-en-male-professional
TTS_PROVIDER=auto                              # auto | silk | elevenlabs

# ─── LiveKit (Voice Agent Infrastructure) ────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
SIP_OUTBOUND_TRUNK_ID=your_sip_trunk_id

# ─── FAISS / Vector Store ─────────────────────────────────────────────────────
VECTOR_STORE_PATH=./ml/vector_store
VECTOR_EMBEDDING_MODEL=text-embedding-3-small
VECTOR_TOP_K=3

# ─── Compliance ───────────────────────────────────────────────────────────────
FDCPA_CALL_WINDOW_START=8             # 8 AM local borrower time
FDCPA_CALL_WINDOW_END=21              # 9 PM local borrower time
FDCPA_MAX_CALLS_PER_DAY=1
FDCPA_MAX_CALLS_PER_WEEK=3
FDCPA_MAX_CALLS_PER_MONTH=12

# ─── PII Encryption ───────────────────────────────────────────────────────────
PII_ENCRYPTION_KEY=base64-encoded-32-byte-fernet-key

# ─── Monitoring ───────────────────────────────────────────────────────────────
PROMETHEUS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ─── JWT / Auth ───────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Stripe (Billing) ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
STRIPE_PRICE_ID_STARTER=price_starter_xxx
STRIPE_PRICE_ID_GROWTH=price_growth_xxx

# ─── Email (SendGrid) ────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM_ADDRESS=noreply@debtcollector.ai
EMAIL_FROM_NAME=DebtCollector

# ─── ML ───────────────────────────────────────────────────────────────────────
ML_MODELS_PATH=./ml/models
ML_STRATEGY_MODEL_FILE=strategy_model.pkl
ML_MODEL_REFRESH_INTERVAL_SECONDS=3600
